import { useState, useEffect } from 'react';
import { initializeApp } from 'firebase/app';
import { getAuth, signInWithCustomToken, signInAnonymously } from 'firebase/auth';
import { getFirestore, doc, setDoc, getDoc, collection, query, onSnapshot, updateDoc, addDoc } from 'firebase/firestore';
import { ArrowUp, ArrowDown, Users, Settings, PlusCircle, CheckCircle } from 'lucide-react';

// Use a shared app ID for the whole application
const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-app-id';
const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {};
const initialAuthToken = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null;

// Initialize Firebase App
const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);

// A simple utility function for a delay with exponential backoff
const exponentialBackoff = async (func, retries = 5, delay = 1000) => {
  try {
    return await func();
  } catch (error) {
    if (retries === 0) throw error;
    console.warn(`Attempt failed. Retrying in ${delay / 1000}s...`);
    await new Promise(res => setTimeout(res, delay));
    return exponentialBackoff(func, retries - 1, delay * 2);
  }
};

const Card = ({ children }) => (
  <div className="bg-white dark:bg-gray-800 p-6 rounded-2xl shadow-lg border border-gray-200 dark:border-gray-700 w-full max-w-2xl mx-auto">
    {children}
  </div>
);

const Button = ({ onClick, children, className = '', disabled = false }) => (
  <button
    onClick={onClick}
    disabled={disabled}
    className={`
      bg-green-600 hover:bg-green-700 text-white font-semibold py-2 px-4 rounded-xl
      transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-green-500
      disabled:bg-gray-400 disabled:cursor-not-allowed
      ${className}
    `}
  >
    {children}
  </button>
);

const AdminView = ({ students, goToLeaderboard, userId, isAuthReady }) => {
  const [newStudentName, setNewStudentName] = useState('');
  const [pointUpdates, setPointUpdates] = useState({});
  const [isLoading, setIsLoading] = useState(false);

  const handlePointChange = (id, delta) => {
    setPointUpdates(prev => ({
      ...prev,
      [id]: (prev[id] || 0) + delta
    }));
  };

  const handleUpdatePoints = async (studentId, pointsToAdd) => {
    if (pointsToAdd === 0) return;
    setIsLoading(true);
    const studentRef = doc(db, 'artifacts', appId, 'public', 'data', 'students', studentId);
    try {
      await exponentialBackoff(() => updateDoc(studentRef, {
        points: students.find(s => s.id === studentId).points + pointsToAdd
      }));
      setPointUpdates(prev => {
        const newUpdates = { ...prev };
        delete newUpdates[studentId];
        return newUpdates;
      });
    } catch (e) {
      console.error('Error updating document: ', e);
    } finally {
      setIsLoading(false);
    }
  };

  const handleAddStudent = async () => {
    if (!newStudentName.trim()) return;
    setIsLoading(true);
    try {
      await exponentialBackoff(() => addDoc(collection(db, 'artifacts', appId, 'public', 'data', 'students'), {
        name: newStudentName,
        points: 0,
        createdAt: new Date()
      }));
      setNewStudentName('');
    } catch (e) {
      console.error('Error adding document: ', e);
    } finally {
      setIsLoading(false);
    }
  };

  return (
    <Card>
      <div className="flex justify-between items-center mb-6">
        <h2 className="text-2xl font-bold text-gray-900 dark:text-white">Ambassador Leaderboard Admin</h2>
        <Button onClick={goToLeaderboard}>
          <Users size={18} className="inline mr-2" /> Leaderboard
        </Button>
      </div>
      {/* User ID display removed */}
      <div className="flex flex-col sm:flex-row items-center space-y-4 sm:space-y-0 sm:space-x-4 mb-8 p-4 bg-gray-100 dark:bg-gray-700 rounded-lg">
        <input
          type="text"
          value={newStudentName}
          onChange={(e) => setNewStudentName(e.target.value)}
          placeholder="Enter student name"
          className="w-full sm:flex-1 p-3 rounded-lg border border-gray-300 focus:ring-green-500 focus:border-green-500 dark:bg-gray-800 dark:text-white dark:border-gray-600"
        />
        <Button onClick={handleAddStudent} disabled={isLoading || !isAuthReady}>
          <PlusCircle size={18} className="inline mr-2" /> Add Ambassador
        </Button>
      </div>
      <div className="space-y-4">
        {students.length === 0 ? (
          <p className="text-center text-gray-500 dark:text-gray-400">No ambassadors found. Add one above.</p>
        ) : (
          students.map(student => {
            const displayPoints = student.points + (pointUpdates[student.id] || 0);
            return (
              <div key={student.id} className="flex flex-col sm:flex-row items-center justify-between bg-gray-50 dark:bg-gray-900 p-4 rounded-xl shadow-sm">
                <span className="font-medium text-gray-800 dark:text-white mb-2 sm:mb-0 sm:mr-4">{student.name}</span>
                <span className="text-lg font-bold text-gray-700 dark:text-gray-300">{displayPoints} Points</span>
                <div className="flex space-x-2 mt-2 sm:mt-0">
                  <button
                    onClick={() => handlePointChange(student.id, 1)}
                    className="p-2 rounded-full text-white bg-gray-500 hover:bg-gray-600 transition-colors duration-200"
                  >
                    <ArrowUp size={16} />
                  </button>
                  <button
                    onClick={() => handlePointChange(student.id, -1)}
                    className="p-2 rounded-full text-white bg-gray-500 hover:bg-gray-600 transition-colors duration-200"
                  >
                    <ArrowDown size={16} />
                  </button>
                  {pointUpdates[student.id] && (
                    <Button onClick={() => handleUpdatePoints(student.id, pointUpdates[student.id])} disabled={isLoading || !isAuthReady}>
                      Update
                    </Button>
                  )}
                </div>
              </div>
            );
          })
        )}
      </div>
    </Card>
  );
};

const LeaderboardView = ({ students, goToAdmin, userId }) => {
  const sortedStudents = [...students].sort((a, b) => b.points - a.points);
  return (
    <Card>
      <div className="flex justify-between items-center mb-6">
        <h2 className="text-2xl font-bold text-gray-900 dark:text-white">Ambassador Leaderboard</h2>
        <Button onClick={goToAdmin}>
          <Settings size={18} className="inline mr-2" /> Admin
        </Button>
      </div>
      {/* User ID display removed */}
      <div className="space-y-4">
        {sortedStudents.length === 0 ? (
          <p className="text-center text-gray-500 dark:text-gray-400">Loading leaderboard...</p>
        ) : (
          sortedStudents.map((student, index) => (
            <div
              key={student.id}
              className={`
                flex items-center justify-between p-4 rounded-xl shadow-sm
                ${index < 3 ? 'bg-amber-100 dark:bg-amber-900' : 'bg-gray-50 dark:bg-gray-900'}
                ${student.id === userId ? 'ring-2 ring-green-500' : ''}
              `}
            >
              <div className="flex items-center">
                <span className="text-xl font-bold w-8 text-center text-gray-700 dark:text-gray-300">{index + 1}</span>
                <span className="ml-4 font-medium text-gray-800 dark:text-white">{student.name}</span>
              </div>
              <span className="text-lg font-bold text-gray-700 dark:text-gray-300">{student.points} pts</span>
            </div>
          ))
        )}
      </div>
    </Card>
  );
};

const PasswordView = ({ onPasswordSubmit, onCancel }) => {
  const [password, setPassword] = useState('');
  const [error, setError] = useState('');
  const handleSubmit = (e) => {
    e.preventDefault();
    if (password === 'GoIr!sh') {
      onPasswordSubmit();
    } else {
      setError('Incorrect password. Please try again.');
    }
  };
  return (
    <Card>
      <form onSubmit={handleSubmit} className="flex flex-col items-center space-y-4">
        <h2 className="text-xl font-bold text-gray-900 dark:text-white">Enter Admin Password</h2>
        <input
          type="password"
          value={password}
          onChange={(e) => setPassword(e.target.value)}
          placeholder="Password"
          className="w-full p-3 rounded-lg border border-gray-300 focus:ring-green-500 focus:border-green-500 dark:bg-gray-800 dark:text-white dark:border-gray-600"
        />
        {error && <p className="text-red-500 text-sm">{error}</p>}
        <div className="flex space-x-4">
          <Button type="submit">
            <CheckCircle size={18} className="inline mr-2" /> Submit
          </Button>
          <Button type="button" onClick={onCancel}>
            <Users size={18} className="inline mr-2" /> Cancel
          </Button>
        </div>
      </form>
    </Card>
  );
};

const App = () => {
  const [students, setStudents] = useState([]);
  const [isAuthReady, setIsAuthReady] = useState(false);
  const [userId, setUserId] = useState(null);
  const [currentView, setCurrentView] = useState('leaderboard'); // 'leaderboard', 'admin', or 'password'
  useEffect(() => {
    const initializeAuth = async () => {
      try {
        if (initialAuthToken) {
          await exponentialBackoff(() => signInWithCustomToken(auth, initialAuthToken));
        } else {
          await exponentialBackoff(() => signInAnonymously(auth));
        }
        setIsAuthReady(true);
      } catch (e) {
        console.error("Authentication failed:", e);
      }
    };
    if (!isAuthReady) {
      initializeAuth();
    }
    const unsubscribeAuth = auth.onAuthStateChanged(user => {
      if (user) {
        setUserId(user.uid);
      }
    });
    return () => unsubscribeAuth();
  }, [isAuthReady]);
  useEffect(() => {
    if (!isAuthReady || !userId) return;
    const studentsCollectionRef = collection(db, 'artifacts', appId, 'public', 'data', 'students');
    const unsubscribe = onSnapshot(studentsCollectionRef, (snapshot) => {
      const studentsList = [];
      snapshot.forEach(doc => {
        studentsList.push({ id: doc.id, ...doc.data() });
      });
      setStudents(studentsList);
    }, (error) => {
      console.error("Error fetching students:", error);
    });
    return () => unsubscribe();
  }, [isAuthReady, userId]);
  return (
    <div className="min-h-screen bg-gray-100 dark:bg-gray-900 text-gray-900 dark:text-white font-sans flex items-center justify-center p-4">
      <div className="w-full max-w-2xl">
        {isAuthReady ? (
          <>
            {currentView === 'leaderboard' && (
              <LeaderboardView
                students={students}
                goToAdmin={() => setCurrentView('password')}
                userId={userId}
              />
            )}
            {currentView === 'password' && (
              <PasswordView
                onPasswordSubmit={() => setCurrentView('admin')}
                onCancel={() => setCurrentView('leaderboard')}
              />
            )}
            {currentView === 'admin' && (
              <AdminView
                students={students}
                goToLeaderboard={() => setCurrentView('leaderboard')}
                userId={userId}
                isAuthReady={isAuthReady}
              />
            )}
          </>
        ) : (
          <div className="text-center p-8 text-gray-500 dark:text-gray-400">
            Loading...
          </div>
        )}
      </div>
    </div>
  );
};
export default App;


